{
  "name": "playwright-summary-reporter",
  "version": "2.1.0",
  "description": "Zero-dependency Playwright custom reporter for fast CI failure triage, GitHub Actions Job Summaries (GITHUB_STEP_SUMMARY), 1-click local re-run commands, and AI-ready debugging prompts.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "playwright",
    "playwright-reporter",
    "playwright-test",
    "github-actions",
    "github-step-summary",
    "flaky-tests",
    "ci-cd",
    "sdet",
    "ai-debugging",
    "test-automation",
    "e2e-testing",
    "typescript"
  ],
  "author": {
    "name": "Md Salekin Newaz",
    "url": "https://salekin-dev.vercel.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salekinnewaz/playwright-summary-reporter.git"
  },
  "homepage": "https://github.com/salekinnewaz/playwright-summary-reporter#readme",
  "bugs": {
    "url": "https://github.com/salekinnewaz/playwright-summary-reporter/issues"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config examples/playwright.config.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
